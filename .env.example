# ============ 复制为 .env 后使用 ============
# cp .env.example .env

# ---- 数据与媒体 ----
# MVP 用 SQLite；换 Postgres 只需改这一行 + JobsRepository 的出队实现
DATABASE_URL=sqlite+pysqlite:////data/de_nachhall.db
MEDIA_ROOT=/data/media

# ---- 宿主代理 ----
# 只有在**直连出不去**的网络里才需要。能直接上网就留空。
#
# 值取决于你自己机器上跑的是什么、监听哪个端口 —— 下面只是格式示例，
# 不要照抄端口。查自己的：
#     env | grep -i proxy
#     ss -ltnp | grep -iE "clash|mihomo|v2ray|sing-box"
#
# 注意它必须是**宿主**上的地址：api 与 worker 用 network_mode: host，
# 所以这里写 127.0.0.1 指的就是宿主的 loopback，是对的。
#
# HOST_PROXY=http://127.0.0.1:<你的端口>
HOST_PROXY=

# ---- LLM（分章 + 标题 + 逐句中文翻译，单次调用） ----
# claude | openai_compat | null
LLM_PROVIDER=claude
LLM_MODEL=claude-sonnet-5
ANTHROPIC_API_KEY=

# 换千问 / GPT / DeepSeek / Ollama 时改成：
#   LLM_PROVIDER=openai_compat
#   LLM_MODEL=qwen-plus
#   LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
#   LLM_API_KEY=sk-...
# LLM_BASE_URL=
# LLM_API_KEY=

# ---- 转写 ----
# int8_float16 而非 float16 —— Sprint 0 实测 float16 在 6GB 卡上 OOM
WHISPER_MODEL=large-v3
WHISPER_DEVICE=cuda
WHISPER_COMPUTE_TYPE=int8_float16

# ---- 切分 ----
# 目标词数而非阈值。bestfit 就近取优，不设硬上限。
# 实测 target=22 → 平均 22.4 词 / 8.9 秒 / 零长块
CHUNK_TARGET_WORDS=22

# ---- 回声 ----
RECORD_TIMEOUT_S=180

# ---- worker ----
WORKER_POLL_INTERVAL_S=2

# ---- 前端 ----
VITE_API_BASE=http://localhost:8001
